{
  "openapi": "3.1.0",
  "info": {
    "title": "CreatOK API",
    "version": "1.1.0",
    "description": "Asynchronous media generation API. Authenticate with a Bearer organization API key (cok_). Personal CLI/MCP keys are not accepted. Resource responses are returned directly, without a code/data envelope. Each response includes X-Request-Id."
  },
  "servers": [
    {
      "url": "https://api.creatok.ai/v1"
    }
  ],
  "paths": {
    "/files": {
      "post": {
        "operationId": "createFileUpload",
        "summary": "Create a size-limited TOS upload grant",
        "description": "Upload with multipart/form-data POST, include every returned upload_fields entry, and put the file field last. TOS enforces the signed size limit: 10 MiB for image content types, 100 MiB otherwise. The grant expires after six hours. Finish uploading before referencing file_id or upload_fields.key in generation input. Upload success does not guarantee model compatibility; generation validates media type, dimensions, duration and model-specific limits.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A signed TOS POST upload form and its object identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUpload"
                }
              }
            }
          },
          "400": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/videos/generation": {
      "post": {
        "operationId": "createVideoGeneration",
        "summary": "Create a video generation job",
        "description": "Generate from text, reference images/videos/audio, or first/end frames. Audio references are supported by Seedance 2, Mini, and Fast, but not Seedance 2.5. Seedance 2.5 also supports adaptive editing. Charges use estimated token usage and model/input-mode unit prices, not a fixed per-second rate. Reference video duration contributes to usage. See the console pricing page for current rates. Reuse the same Idempotency-Key and body to retrieve the original Job without another charge; changing the body with that key returns 409. The default workspace limit is 10 unfinished jobs. Always inspect Job.status, including on 202 responses.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationRequest"
              },
              "examples": {
                "text": {
                  "value": {
                    "model": "seedance-2-mini",
                    "input": {
                      "prompt": "A quiet lake at sunrise",
                      "definition": "480p",
                      "seconds": 4,
                      "orientation": "16:9"
                    }
                  }
                },
                "referenceImage": {
                  "value": {
                    "model": "seedance-2-mini",
                    "input": {
                      "prompt": "Animate this product",
                      "referenceImageKeys": [
                        "file_11111111-1111-4111-8111-111111111111"
                      ]
                    }
                  }
                },
                "referenceVideo": {
                  "value": {
                    "model": "seedance-2-mini",
                    "input": {
                      "prompt": "Use the reference camera movement",
                      "referenceVideoKeys": [
                        "file_22222222-2222-4222-8222-222222222222"
                      ]
                    }
                  }
                },
                "referenceAudio": {
                  "value": {
                    "model": "seedance-2-mini",
                    "input": {
                      "prompt": "Match the rhythm of the reference audio",
                      "referenceAudioKey": "file_33333333-3333-4333-8333-333333333333"
                    }
                  }
                },
                "frames": {
                  "value": {
                    "model": "seedance-2-mini",
                    "input": {
                      "prompt": "Transition smoothly between these frames",
                      "generationMode": "frame",
                      "firstFrameKey": "file_11111111-1111-4111-8111-111111111111",
                      "endFrameKey": "file_33333333-3333-4333-8333-333333333333"
                    }
                  }
                },
                "edit": {
                  "value": {
                    "model": "seedance-2.5",
                    "input": {
                      "prompt": "Replace the background with a beach",
                      "generationMode": "edit",
                      "referenceVideoKeys": [
                        "file_22222222-2222-4222-8222-222222222222"
                      ],
                      "autoMatchVideoDuration": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "A Job resource, including idempotent replays and immediate submission failures. Retry-After: 10 is included while queued/running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retrying a concurrency-limited request.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Concurrency checking is temporarily unavailable. Retry with the same idempotency key and body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List jobs for the authenticated organization",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Comma-separated job statuses.",
            "schema": {
              "type": "string",
              "example": "queued,running"
            }
          },
          {
            "name": "api_key_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "created_after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of jobs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "400": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "operationId": "getJob",
        "summary": "Retrieve a job",
        "description": "Poll using Retry-After (10 seconds while queued/running). Job data may be cached for up to 60 seconds and is invalidated on status updates. Download URLs last about one hour; retrieve the Job again for fresh URLs. output.files is empty after expires_at, 48 hours after completion.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Present only while queued/running; seconds before polling again.",
                "schema": {
                  "type": "integer",
                  "example": 10
                }
              }
            }
          },
          "401": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/account": {
      "get": {
        "operationId": "getAccount",
        "summary": "Retrieve account balance and concurrency information",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Account resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "401": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Request failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "CreatOK organization API key"
      }
    },
    "schemas": {
      "FileUploadRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "content_type": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z0-9!#$&^_.+-]+\\/[a-z0-9!#$&^_.+-]+$"
          },
          "size": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "content_type",
          "size",
          "filename"
        ],
        "additionalProperties": false
      },
      "FileUpload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "file_upload"
          },
          "file_id": {
            "type": "string"
          },
          "upload_url": {
            "type": "string",
            "format": "uri"
          },
          "upload_fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          }
        },
        "required": [
          "object",
          "file_id",
          "upload_url",
          "upload_fields",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "GenerationRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Public model ID: seedance-2.5, seedance-2, seedance-2-fast, seedance-2-mini. Only these models are accepted."
          },
          "input": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "Required description of the requested video."
              },
              "orientation": {
                "description": "21:9, 16:9, 4:3, 1:1, 3:4, 9:16, or auto. Defaults to 9:16 for text/reference modes. Omit in Seedance 2.5 frame and edit modes.",
                "type": "string"
              },
              "seconds": {
                "description": "Integer output duration: 4–15 seconds, or 4–30 for Seedance 2.5. Defaults to 4. In edit mode omit this field: duration follows the source video.",
                "type": "number"
              },
              "definition": {
                "description": "Defaults to 480p. Seedance 2 supports 480p/720p/1080p/4k; 2.5 supports 480p/720p/1080p; Mini and Fast support 480p/720p.",
                "type": "string"
              },
              "watermark": {
                "type": "boolean"
              },
              "seed": {
                "type": "string"
              },
              "referenceImageKeys": {
                "description": "Uploaded reference images. Cannot be combined with first/end frames.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A file_id returned by POST /files, or its upload_fields.key. Must belong to the authenticated organization."
                }
              },
              "referenceVideoKeys": {
                "description": "Uploaded reference videos. Required for Seedance 2.5 edit mode. Duration is inspected by the server and contributes to token pricing.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A file_id returned by POST /files, or its upload_fields.key. Must belong to the authenticated organization."
                }
              },
              "referenceAudioKey": {
                "description": "One uploaded reference audio file for Seedance 2, Mini, or Fast. Not supported by Seedance 2.5. Cannot be combined with first/end frames.",
                "type": "string",
                "minLength": 1
              },
              "firstFrameKey": {
                "description": "Uploaded first-frame image; required in frame mode.",
                "type": "string",
                "minLength": 1
              },
              "endFrameKey": {
                "description": "Optional uploaded end-frame image; requires firstFrameKey.",
                "type": "string",
                "minLength": 1
              },
              "generationMode": {
                "description": "Inferred from frame/reference inputs when omitted. Frame inputs cannot be mixed with reference inputs. edit is Seedance 2.5 only and requires referenceVideoKeys; its duration and aspect ratio follow the source video.",
                "type": "string",
                "enum": [
                  "frame",
                  "reference",
                  "edit"
                ]
              },
              "autoMatchVideoDuration": {
                "description": "Seedance 2.5 edit mode follows the source video's duration automatically; true is supported only in that mode.",
                "type": "boolean"
              }
            },
            "required": [
              "prompt"
            ],
            "additionalProperties": false
          },
          "max_cost_usd": {
            "description": "Maximum charge in USD as a decimal string with up to six decimal places. The request is rejected before charging if the quote exceeds this amount.",
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,6})?$"
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "model",
          "input"
        ],
        "additionalProperties": false
      },
      "Job": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "job"
          },
          "capability": {
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "canceled"
            ]
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "output": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "url"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "files"
            ],
            "additionalProperties": false
          },
          "cost": {
            "type": "object",
            "properties": {
              "amount_usd": {
                "type": "string",
                "description": "Original charge in USD, as a decimal string with six places. It does not decrease after a refund."
              },
              "refunded_usd": {
                "type": "string",
                "description": "Actual refunded USD, as a decimal string with six places; zero until a refund is recorded."
              }
            },
            "required": [
              "amount_usd",
              "refunded_usd"
            ],
            "additionalProperties": false
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "created_at": {
            "type": "string"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "object",
          "capability",
          "model",
          "status",
          "input",
          "output",
          "cost",
          "error",
          "metadata",
          "created_at",
          "completed_at",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "JobList": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "object": {
                  "type": "string",
                  "const": "job"
                },
                "capability": {
                  "type": "string"
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "queued",
                    "running",
                    "succeeded",
                    "failed",
                    "canceled"
                  ]
                },
                "input": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "output": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "url"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "files"
                  ],
                  "additionalProperties": false
                },
                "cost": {
                  "type": "object",
                  "properties": {
                    "amount_usd": {
                      "type": "string",
                      "description": "Original charge in USD, as a decimal string with six places. It does not decrease after a refund."
                    },
                    "refunded_usd": {
                      "type": "string",
                      "description": "Actual refunded USD, as a decimal string with six places; zero until a refund is recorded."
                    }
                  },
                  "required": [
                    "amount_usd",
                    "refunded_usd"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "metadata": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "created_at": {
                  "type": "string"
                },
                "completed_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expires_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "object",
